script = ExtResource("18_1kfh5")
title = "07 - Slow lowland river"
description = "A wide, slow, silty river: the 'lowland' style (turbidity, sediment colour, surface slicks).
Press 5 to compare: peat is clear but tea-stained, muddy is a flood. No re-bake needed."
