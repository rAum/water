; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Flowing Water"
run/main_scene="res://examples/demo/demo.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

WaterManager="*uid://djslnvhmnnjwc"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/flowing_water/plugin.cfg")

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4

[shader_globals]

flowing_water_noise={
"type": "sampler2D",
"value": ""
}
flowing_water_map={
"type": "sampler2D",
"value": ""
}
flowing_water_map_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
flowing_water_map_base={
"type": "float",
"value": 0.0
}
flowing_water_time={
"type": "float",
"value": 0.0
}
flowing_water_map_focus={
"type": "vec4",
"value": Vector4(0, 0, 1e+06, 2e+06)
}
flowing_water_ripple={
"type": "sampler2D",
"value": ""
}
flowing_water_ripple_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
flowing_water_caustics={
"type": "float",
"value": 1.0
}
flowing_water_turbidity={
"type": "float",
"value": 0.0
}
flowing_water_storm_color={
"type": "vec3",
"value": Vector3(0.33, 0.24, 0.13)
}
